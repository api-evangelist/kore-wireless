    {
      "info": {
        "name": "UsageRecords Resource",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Data Usage records for an account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://programmable-wireless.api.korewireless.com/v1/UsageRecords",
            "params": [
              {
                "name": "Start",
                "value": "",
                "type": "query",
                "description": "Only include usage that has occurred on or after this date. Format is ISO 8601"
              },
              {
                "name": "End",
                "value": "",
                "type": "query",
                "description": "Only include usage that has occurred on or before this date. Format is ISO 8601."
              },
              {
                "name": "Granularity",
                "value": "",
                "type": "query",
                "description": "How to summarize the usage by time. Can be - daily, hourly, or all. A value of all returns one Usage Record that describes the usage for the entire period."
              },
              {
                "name": "PageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "Page",
                "value": "",
                "type": "query",
                "description": "The page index. This value is simply for client state."
              },
              {
                "name": "PageToken",
                "value": "",
                "type": "query",
                "description": "The page token. This is provided by the API."
              }
            ]
          },
          "docs": "List Data Usage records for an account"
        },
        {
          "info": {
            "name": "List Data Usage records for a sim",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://programmable-wireless.api.korewireless.com/v1/Sims/:Sid/UsageRecords",
            "params": [
              {
                "name": "Sid",
                "value": "",
                "type": "path",
                "description": "The SID of the Sim resource to read the usage from."
              },
              {
                "name": "Start",
                "value": "",
                "type": "query",
                "description": "Only include usage that has occurred on or after this date. Format is ISO 8601"
              },
              {
                "name": "End",
                "value": "",
                "type": "query",
                "description": "Only include usage that has occurred on or before this date. Format is ISO 8601."
              },
              {
                "name": "Granularity",
                "value": "",
                "type": "query",
                "description": "How to summarize the usage by time. Can be - daily, hourly, or all. A value of all returns one Usage Record that describes the usage for the entire period."
              },
              {
                "name": "PageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "Page",
                "value": "",
                "type": "query",
                "description": "The page index. This value is simply for client state."
              },
              {
                "name": "PageToken",
                "value": "",
                "type": "query",
                "description": "The page token. This is provided by the API."
              }
            ]
          },
          "docs": "List Data Usage records for a sim"
        }
      ]
    },
